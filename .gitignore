.eggs/

# ── ML / data artifacts (regenerated by running the pipeline) ─────────────────
# Stockfish binary (109 MB — download from https://stockfishchess.org/download/)
data/stockfish/

# Per-user pipeline outputs (recreated with: python ml/pipeline.py <username>)
data/output/

# Puzzle index (recreated with: python scripts/run_puzzle_import.py)
data/puzzles/

# SRS state (user-specific, recreated as they drill)
data/seen/

# ── Frontend ──────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/

